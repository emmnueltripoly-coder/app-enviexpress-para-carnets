# ==========================================================================
# Plantilla de variables de entorno — Control de asistencia Enviexpress
#
# USO: copiar a .env y completar con valores reales.
# NUNCA commitear el archivo .env (está en .gitignore).
#
# En producción (Render) las variables se configuran directamente en el
# panel: Service → Settings → Environment. Ver DESPLIEGUE.md.
# ==========================================================================


# --------------------------------------------------------------------------
# Django — Seguridad básica
# --------------------------------------------------------------------------

# Clave secreta de Django. DEBE ser única, larga y aleatoria.
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo debug. True solo en desarrollo. NUNCA True en producción.
DEBUG=True

# Hosts permitidos separados por coma.
# Producción: enviexpress-asistencia.onrender.com,asistencia.enviexpresslogistica.com
ALLOWED_HOSTS=127.0.0.1,localhost


# --------------------------------------------------------------------------
# Base de datos — PostgreSQL (OBLIGATORIO; no se admite SQLite)
# --------------------------------------------------------------------------

# Opción A (producción / Supabase): URL completa. Tiene prioridad sobre DB_*.
# Copiar desde: Supabase → Project Settings → Database → Connection string → URI
# IMPORTANTE: añadir ?sslmode=require al final si la conexión lo requiere.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Opción B (desarrollo local): variables individuales.
DB_NAME=asistencia_db
DB_USER=asistencia_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Tiempo de vida de conexiones persistentes (segundos).
# 0 = sin persistencia (recomendado con pooler de Supabase, puerto 6543).
# 60 = con conexión directa (puerto 5432).
CONN_MAX_AGE=0


# --------------------------------------------------------------------------
# CORS — Control de acceso entre orígenes
# --------------------------------------------------------------------------
# Orígenes permitidos para consumir la API desde un navegador.
# La app móvil nativa (iOS/Android) NO necesita CORS; aplica solo a builds web.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081


# --------------------------------------------------------------------------
# Email — Notificaciones de novedades a RRHH
# --------------------------------------------------------------------------
# En desarrollo: imprime en consola. En producción: usar SMTP real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@enviexpresslogistica.com

# Servidor SMTP (solo para producción). Ej: smtp.gmail.com / smtp.sendgrid.net
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Contraseña de app (Gmail) o API key (SendGrid, Mailgun, etc.).
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Destinatarios del aviso de novedad nueva. Separados por coma.
NOVEDADES_EMAILS=yulieth.alvarez@enviexpresslogistica.com,gloria.arias@enviexpresslogistica.com


# --------------------------------------------------------------------------
# Almacenamiento privado — Soportes de novedades (datos sensibles, Ley 1581)
# --------------------------------------------------------------------------

# --- Modo desarrollo (filesystem local) ---
# Ruta local fuera de cualquier directorio público. Por defecto: <BASE_DIR>/private_media.
# PRIVATE_MEDIA_ROOT=/ruta/absoluta/a/private_media
SOPORTE_MAX_BYTES=10485760

# --- Modo producción (Supabase Storage, S3-compatible) ---
# Si SUPABASE_S3_ACCESS_KEY está presente, se usa S3; si no, cae al filesystem.
# El bucket DEBE ser PRIVADO. El acceso a archivos siempre pasa por la vista
# autenticada de Django (SoporteDescargarView) que audita cada descarga.
# Credenciales: Supabase → Project Settings → Storage → S3 Connection
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Nombre del bucket privado creado en Supabase Storage.
SUPABASE_STORAGE_BUCKET=novedades-soportes
# Endpoint S3 de Supabase: https://<project-id>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT_URL=
# Región (Supabase la ignora, pero boto3 requiere un valor no vacío).
SUPABASE_S3_REGION=us-east-1


# --------------------------------------------------------------------------
# Superusuario inicial (solo para el primer despliegue)
# --------------------------------------------------------------------------
# Usadas por: python manage.py crear_superusuario_inicial
# El comando es idempotente; estas vars se pueden mantener sin riesgo.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@enviexpresslogistica.com
