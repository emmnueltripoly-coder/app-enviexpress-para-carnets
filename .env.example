# ==========================================================================
# Plantilla de variables de entorno. Copiar a .env y completar con valores
# reales. NUNCA commitear el archivo .env (está en .gitignore).
# ==========================================================================

# --- Seguridad Django ---
# Generar una clave nueva, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos PostgreSQL (obligatorio: NO usar SQLite) ---
DB_NAME=asistencia_db
DB_USER=asistencia_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Email / Notificación de novedades (Hito 6) ---
# En desarrollo se imprime en consola; en producción configure SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@enviexpresslogistica.com
# Destinatarios de RRHH que reciben aviso de novedades nuevas (separados por coma).
NOVEDADES_EMAILS=yulieth.alvarez@enviexpresslogistica.com,gloria.arias@enviexpresslogistica.com

# --- Almacenamiento privado de soportes de novedades (datos sensibles) ---
# Ruta NO servida públicamente. Por defecto <BASE_DIR>/private_media.
PRIVATE_MEDIA_ROOT=
SOPORTE_MAX_BYTES=10485760
